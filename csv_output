
"""
extract_payroll.py
------------------
Extracts Name, Address (2-3 lines), and Salary details from a CSV file
produced by a PDF text-extraction pipeline.

Expected CSV format:
    File Name, Page Number, Extracted Text

Key patterns observed:
  - Trigger line  : contains "PURCHASE, NY 10577" (or similar city/state)
  - Name line     : the NEXT line after trigger — may be embedded in phrases like
                    "Taxable Marital Status: Married Didar P. Kumar"
                    → extract the last 2-4 capitalised words as the name
  - Address lines : up to 3 lines after the name line that look like street/city/zip
  - Salary lines  : lines containing Gross Pay, Net Pay, Net Check, Vacation, etc.

Usage:
    python extract_payroll.py input.csv [output.csv]
"""

import csv
import re
import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Config — adjust these patterns to match your data
# ---------------------------------------------------------------------------

# A line containing any of these strings acts as the "name is next" trigger
TRIGGER_PATTERNS = [
    r"PURCHASE,?\s*NY\s*\d+",   # PURCHASE, NY 10577
    r"Pay\s*Date\s*:\s*\d+",    # Pay Date: 09052025  (same line or nearby)
]

# Keywords whose line contains the employee name (name is at the END of the line)
NAME_HINT_KEYWORDS = [
    "Taxable Marital Status",
    "Married",
    "Single",
    "Employee Name",
    "Employee:",
]

# Salary row keywords
SALARY_KEYWORDS = [
    "Gross Pay", "Net Pay", "Net Check",
    "Regular", "Vacation", "Personal",
    "Yend Bonus", "BONUS",
]


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def clean(text: str) -> str:
    return text.strip().strip('"').strip()


def is_trigger_line(text: str) -> bool:
    """Line that signals the name will appear on the next line."""
    for pat in TRIGGER_PATTERNS:
        if re.search(pat, text, re.IGNORECASE):
            return True
    return False


def extract_name_from_line(text: str) -> str | None:
    """
    Given a line that may embed the name (e.g.
    'Taxable Marital Status: Married Didar P. Kumar'),
    return the employee name portion.

    Strategy: after the last colon or keyword, grab the trailing
    2-4 capitalised words.
    """
    # Remove everything up to and including the last colon
    after_colon = re.split(r':', text)[-1].strip()

    # Remove leading filing-status words (Married, Single, Head, etc.)
    after_colon = re.sub(
        r'^(Married|Single|Head\s+of\s+Household|Qualifying\s+Widow\w*)\s*',
        '', after_colon, flags=re.IGNORECASE
    ).strip()

    # What's left should be the name — validate: 2-5 words, mostly alpha
    words = after_colon.split()
    name_words = []
    for w in words:
        # Accept words that are mostly letters (allow periods for initials like P.)
        if re.match(r"^[A-Za-z][A-Za-z'.,-]*$", w):
            name_words.append(w)
        else:
            break  # stop at first non-name token

    if len(name_words) >= 2:
        return " ".join(name_words)
    return None


def is_address_line(text: str) -> bool:
    """
    Street number + name  OR  city/state/zip  OR  keywords like
    'Exemptions/Allowances: 166 KHARAR STREET'  (address embedded after colon).
    """
    # Plain street: starts with digits
    if re.match(r'^\d+\s+\w', text):
        return True
    # City State ZIP
    if re.match(r'^[A-Z][A-Z\s]+\s+[A-Z]{2}\s+\d{5}', text):
        return True
    # Embedded address after keyword (Exemptions/Allowances: 166 ...)
    if re.search(r':\s*\d+\s+[A-Z]', text):
        return True
    # Federal: 0 MOHALI CT 06460  — city embedded
    if re.search(r'Federal:\s*\d+\s+\w', text, re.IGNORECASE):
        return True
    return False


def extract_address_from_line(text: str) -> str:
    """
    If address is embedded after a colon
    e.g. 'Exemptions/Allowances: 166 KHARAR STREET'
    return only the address portion.
    """
    m = re.search(r':\s*(\d+\s+.+)$', text)
    if m:
        return m.group(1).strip()
    m = re.search(r'Federal:\s*\d+\s+(.+)$', text, re.IGNORECASE)
    if m:
        # e.g. "Federal: 0 MOHALI CT 06460" → "MOHALI CT 06460"
        return m.group(1).strip()
    return text


def parse_salary_line(text: str) -> dict:
    """Return salary info dict if the line contains a salary keyword."""
    for kw in SALARY_KEYWORDS:
        if kw.lower() in text.lower():
            amounts = re.findall(r'-?\$[\d,\s]+\.\d{2}', text)
            amounts = [a.replace(' ', '') for a in amounts]

            # Also catch space-separated numbers like "7 222 13" → treat as context
            raw_numbers = re.findall(r'\b\d[\d\s]*\d{2}\s+\d{2}\b', text)

            return {
                "type":    kw,
                "amounts": amounts,
                "raw":     text,
            }
    return {}


# ---------------------------------------------------------------------------
# Core extractor
# ---------------------------------------------------------------------------

def extract_records(csv_path: str) -> list[dict]:
    rows = []
    with open(csv_path, newline='', encoding='utf-8') as fh:
        reader = csv.reader(fh)
        for row in reader:
            if len(row) < 3:
                continue
            file_name = clean(row[0])
            page      = clean(row[1])
            text      = clean(row[2])
            if file_name.lower() in ("file name", "filename"):
                continue
            rows.append((file_name, page, text))

    records = []
    current: dict | None = None

    # States
    S_SEARCHING = "searching"   # looking for trigger line
    S_NAME      = "name"        # next line(s) should give us the name
    S_ADDR      = "addr"        # collecting address lines
    S_SALARY    = "salary"      # collecting salary rows

    state = S_SEARCHING
    addr_count = 0

    for idx, (file_name, page, text) in enumerate(rows):

        # ── TRIGGER ────────────────────────────────────────────────────────
        if is_trigger_line(text):
            # Save previous record
            if current and current.get("name"):
                records.append(current)
            current = {
                "file_name": file_name,
                "page":      page,
                "name":      "",
                "address":   [],
                "salary":    [],
            }
            state = S_NAME
            addr_count = 0
            continue

        # ── NAME ───────────────────────────────────────────────────────────
        if state == S_NAME and current is not None:
            name = extract_name_from_line(text)
            if name:
                current["name"] = name
                state = S_ADDR
                addr_count = 0
            # If name not found yet, stay in S_NAME for next line
            continue

        # ── ADDRESS ────────────────────────────────────────────────────────
        if state == S_ADDR and current is not None:
            if is_address_line(text) and addr_count < 3:
                current["address"].append(extract_address_from_line(text))
                addr_count += 1
                continue
            elif addr_count > 0:
                # Had at least one address line; non-address → move to salary
                state = S_SALARY
                # fall through to salary check

        # ── SALARY ─────────────────────────────────────────────────────────
        if state == S_SALARY and current is not None:
            sal = parse_salary_line(text)
            if sal:
                current["salary"].append(sal)
            # Also detect a new trigger (new employee on same page)
            if is_trigger_line(text):
                if current and current.get("name"):
                    records.append(current)
                current = {
                    "file_name": file_name,
                    "page":      page,
                    "name":      "",
                    "address":   [],
                    "salary":    [],
                }
                state = S_NAME
                addr_count = 0

    if current and current.get("name"):
        records.append(current)

    return records


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def write_output(records: list[dict], out_path: str) -> None:
    fieldnames = [
        "file_name", "page", "name",
        "address_line_1", "address_line_2", "address_line_3",
        "salary_type", "salary_amounts", "salary_raw",
    ]
    with open(out_path, "w", newline='', encoding='utf-8') as fh:
        writer = csv.DictWriter(fh, fieldnames=fieldnames)
        writer.writeheader()
        for rec in records:
            addr = rec["address"] + ["", "", ""]
            if rec["salary"]:
                for sal in rec["salary"]:
                    writer.writerow({
                        "file_name":      rec["file_name"],
                        "page":           rec["page"],
                        "name":           rec["name"],
                        "address_line_1": addr[0],
                        "address_line_2": addr[1],
                        "address_line_3": addr[2],
                        "salary_type":    sal["type"],
                        "salary_amounts": " | ".join(sal["amounts"]),
                        "salary_raw":     sal["raw"],
                    })
            else:
                writer.writerow({
                    "file_name":      rec["file_name"],
                    "page":           rec["page"],
                    "name":           rec["name"],
                    "address_line_1": addr[0],
                    "address_line_2": addr[1],
                    "address_line_3": addr[2],
                    "salary_type":    "",
                    "salary_amounts": "",
                    "salary_raw":     "",
                })


def print_summary(records: list[dict]) -> None:
    for i, rec in enumerate(records, 1):
        print(f"\n{'='*60}")
        print(f"Record #{i}  [{rec['file_name']} | page {rec['page']}]")
        print(f"  Name      : {rec['name']}")
        for j, line in enumerate(rec["address"], 1):
            print(f"  Address {j} : {line}")
        if rec["salary"]:
            print("  Salary    :")
            for sal in rec["salary"]:
                amt = " | ".join(sal["amounts"]) if sal["amounts"] else sal["raw"]
                print(f"    {sal['type']:<15} → {amt}")
    print(f"\n{'='*60}")
    print(f"Total records extracted: {len(records)}")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python extract_payroll.py <input.csv> [output.csv]")
        sys.exit(1)

    input_csv  = sys.argv[1]
    output_csv = sys.argv[2] if len(sys.argv) > 2 else None

    if not Path(input_csv).exists():
        print(f"Error: file not found → {input_csv}")
        sys.exit(1)

    records = extract_records(input_csv)
    print_summary(records)

    if output_csv:
        write_output(records, output_csv)
        print(f"\nOutput written to: {output_csv}")
